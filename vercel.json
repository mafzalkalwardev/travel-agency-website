{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "ignoreCommand": "node -e \"process.exit(process.env.VERCEL_GIT_COMMIT_REF==='inventory-cache'?0:1)\"",
  "crons": [
    {
      "path": "/api/cron/cleanup-maintenance",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/cron/retry-booking-holds",
      "schedule": "30 0 * * *"
    },
    {
      "path": "/api/cron/watch-booking-holds",
      "schedule": "45 0 * * *"
    }
  ]
}
